# ==============================================================================
# Rithm UI — Production & Local Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE / DEPLOYMENT URL
# ------------------------------------------------------------------------------
# On Vercel, this is your production domain (e.g., https://rithmui.com)
NEXT_PUBLIC_APP_URL="https://rithmui.com"
NEXTAUTH_URL="https://rithmui.com"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH / AUTH.JS SECRETS
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-char-random-secret"
NEXTAUTH_SECRET="your-32-char-random-secret"

# GitHub OAuth App (Create at https://github.com/settings/developers)
# Callback URL: https://rithmui.com/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (Create at https://console.cloud.google.com/apis/credentials)
# Callback URL: https://rithmui.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 3. SUPABASE (Database for Auth, Waitlist, Orders, Templates)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# 4. DODO PAYMENTS (Billing / Pro Waitlist / Checkout)
# ------------------------------------------------------------------------------
# Dodo Dashboard -> Developer -> API Keys & Webhooks
DODO_PAYMENTS_API_KEY="whsec_... or live_..."
DODO_PAYMENTS_WEBHOOK_SECRET="whsec_..."
DODO_PAYMENTS_ENVIRONMENT="live_mode" # Use 'test_mode' for local testing
DODO_PAYMENTS_RETURN_URL="https://rithmui.com/success"
DODO_PRO_WAITLIST_PRODUCT_ID="pdt_..."

# Public Pricing Display
NEXT_PUBLIC_PRO_LAUNCH_PRICE="199"
NEXT_PUBLIC_PRO_RENEWAL_PRICE="79"
NEXT_PUBLIC_PRO_WAITLIST_FEE="199"

# ------------------------------------------------------------------------------
# 5. RESEND (Transactional Emails)
# ------------------------------------------------------------------------------
# Resend API Key from https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL="sharmashivam32622@gmail.com"

# Admin Dashboard credentials for /api/dashboard
ADMIN_EMAIL="sharmashivam32622@gmail.com"
ADMIN_PASSWORD="your-strong-admin-password"

# ------------------------------------------------------------------------------
# 6. MONGODB (Optional: Only needed if using component submission dashboard)
# ------------------------------------------------------------------------------
MONGODB_URL="mongodb+srv://..."

# ------------------------------------------------------------------------------
# 7. POSTHOG ANALYTICS (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ------------------------------------------------------------------------------
# 8. CLOUDINARY (Optional: for custom image uploads)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
